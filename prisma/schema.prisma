// MIAN DUBAI — data model
// Phase 1: catalog + content + admin only. No customer accounts, orders or
// payments. Customer/Order modules are a documented future extension; see
// docs/ARCHITECTURE.md ("Future extension points").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FragranceType {
  PARFUM
  EXTRAIT_DE_PARFUM
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  COLOGNE
  OTHER
}

enum Audience {
  MEN
  WOMEN
  UNISEX
}

enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum WhatsAppSource {
  GLOBAL
  PRODUCT
  BAG
  CONTACT
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

model AdminUser {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid()) @db.VarChar(36)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  displayName  String    @db.VarChar(120)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  // Bumped on password change / forced logout to invalidate issued cookies.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int?
  action      String   @db.VarChar(64)
  entityType  String?  @db.VarChar(64)
  entityId    String?  @db.VarChar(64)
  metadata    Json?
  ipHash      String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid()) @db.VarChar(36)
  // Storage-relative key, e.g. "products/2026/02/ab12....jpg".
  // Never an absolute filesystem path — the driver resolves it at runtime.
  storageKey       String   @unique @db.VarChar(400)
  // Optional absolute override. Normally null; the URL is derived from
  // MEDIA_PUBLIC_URL so the media host can change without a data migration.
  publicUrl        String?  @db.VarChar(500)
  originalFilename String   @db.VarChar(255)
  storedFilename   String   @db.VarChar(255)
  mimeType         String   @db.VarChar(80)
  width            Int
  height           Int
  sizeBytes        Int
  // [{ width, key, mimeType, sizeBytes }] derivatives produced by Sharp.
  variants         Json?
  createdAt        DateTime @default(now())

  productImages ProductImage[]

  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id                Int           @id @default(autoincrement())
  uuid              String        @unique @default(uuid()) @db.VarChar(36)
  slug              String        @unique @db.VarChar(191)
  sku               String        @unique @db.VarChar(64)
  brandName         String        @default("Mian Dubai") @db.VarChar(120)
  status            ProductStatus @default(DRAFT)
  fragranceType     FragranceType @default(EAU_DE_PARFUM)
  audience          Audience      @default(UNISEX)
  sizeMl            Int?
  priceUsd          Decimal       @db.Decimal(10, 2)
  priceAed          Decimal?      @db.Decimal(10, 2)
  compareAtPriceUsd Decimal?      @db.Decimal(10, 2)
  compareAtPriceAed Decimal?      @db.Decimal(10, 2)
  stockQuantity     Int           @default(0)
  lowStockThreshold Int           @default(3)
  processingMinDays Int?
  processingMaxDays Int?
  // Per-product override of the site-wide delivery estimate.
  deliveryMinDays   Int?
  deliveryMaxDays   Int?
  // Ingredient declaration transcribed from the physical label by an admin.
  // Never generated automatically.
  ingredients       String?       @db.Text

  featured           Boolean @default(false)
  bestseller         Boolean @default(false)
  newArrival         Boolean @default(false)
  allowWhatsAppOrder Boolean @default(true)
  sortOrder          Int     @default(0)

  // Optional future 3D assets. Absent by default; no viewer is rendered
  // unless one of these is populated.
  model3dGlbUrl  String? @db.VarChar(500)
  model3dUsdzUrl String? @db.VarChar(500)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  translations ProductTranslation[]
  images       ProductImage[]
  categories   ProductCategory[]
  collections  ProductCollection[]

  @@index([status, deletedAt])
  @@index([featured])
  @@index([bestseller])
  @@index([newArrival])
  @@index([audience])
  @@index([fragranceType])
  @@index([publishedAt])
  @@index([sortOrder])
  @@map("products")
}

model ProductTranslation {
  id               Int     @id @default(autoincrement())
  productId        Int
  locale           String  @db.VarChar(5)
  name             String  @db.VarChar(191)
  shortDescription String? @db.VarChar(500)
  fullDescription  String? @db.Text
  scentStory       String? @db.Text
  topNotes         String? @db.VarChar(500)
  heartNotes       String? @db.VarChar(500)
  baseNotes        String? @db.VarChar(500)
  howToUse         String? @db.Text
  safetyText       String? @db.Text
  seoTitle         String? @db.VarChar(191)
  seoDescription   String? @db.VarChar(320)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@index([name])
  @@map("product_translations")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  mediaAssetId Int
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  altEn        String?  @db.VarChar(255)
  altFr        String?  @db.VarChar(255)
  altEs        String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_images")
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(191)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  products     ProductCategory[]

  @@map("categories")
}

model CategoryTranslation {
  id             Int     @id @default(autoincrement())
  categoryId     Int
  locale         String  @db.VarChar(5)
  name           String  @db.VarChar(191)
  description    String? @db.Text
  seoTitle       String? @db.VarChar(191)
  seoDescription String? @db.VarChar(320)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Collection {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(191)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  showOnHome   Boolean  @default(true)
  heroMediaKey String?  @db.VarChar(400)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations CollectionTranslation[]
  products     ProductCollection[]

  @@map("collections")
}

model CollectionTranslation {
  id             Int     @id @default(autoincrement())
  collectionId   Int
  locale         String  @db.VarChar(5)
  name           String  @db.VarChar(191)
  tagline        String? @db.VarChar(255)
  description    String? @db.Text
  seoTitle       String? @db.VarChar(191)
  seoDescription String? @db.VarChar(320)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@map("collection_translations")
}

model ProductCategory {
  productId  Int
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    Int
  collectionId Int
  sortOrder    Int @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

// ---------------------------------------------------------------------------
// Site configuration and editorial content
// ---------------------------------------------------------------------------

model SiteSetting {
  id        Int         @id @default(autoincrement())
  key       String      @unique @db.VarChar(120)
  value     String?     @db.Text
  type      SettingType @default(STRING)
  // Only settings flagged public are exposed through /api/v1/site/public.
  isPublic  Boolean     @default(false)
  group     String      @default("general") @db.VarChar(60)
  updatedAt DateTime    @updatedAt

  @@index([group])
  @@map("site_settings")
}

model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(120)
  group     String   @default("home") @db.VarChar(60)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  translations SiteContentTranslation[]

  @@index([group])
  @@map("site_contents")
}

model SiteContentTranslation {
  id            Int     @id @default(autoincrement())
  siteContentId Int
  locale        String  @db.VarChar(5)
  eyebrow       String? @db.VarChar(191)
  heading       String? @db.VarChar(255)
  subheading    String? @db.VarChar(500)
  body          String? @db.Text
  ctaLabel      String? @db.VarChar(120)
  ctaHref       String? @db.VarChar(255)
  ctaLabelAlt   String? @db.VarChar(120)
  ctaHrefAlt    String? @db.VarChar(255)
  // Structured extras for list-shaped blocks (promises, FAQ entries).
  items         Json?

  siteContent SiteContent @relation(fields: [siteContentId], references: [id], onDelete: Cascade)

  @@unique([siteContentId, locale])
  @@map("site_content_translations")
}

model LegalPage {
  id            Int       @id @default(autoincrement())
  slug          String    @unique @db.VarChar(120)
  sortOrder     Int       @default(0)
  isPublished   Boolean   @default(true)
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  translations LegalPageTranslation[]

  @@map("legal_pages")
}

model LegalPageTranslation {
  id             Int     @id @default(autoincrement())
  legalPageId    Int
  locale         String  @db.VarChar(5)
  title          String  @db.VarChar(191)
  // Structured markdown-lite content rendered by the storefront.
  content        String  @db.LongText
  seoTitle       String? @db.VarChar(191)
  seoDescription String? @db.VarChar(320)

  legalPage LegalPage @relation(fields: [legalPageId], references: [id], onDelete: Cascade)

  @@unique([legalPageId, locale])
  @@map("legal_page_translations")
}

// ---------------------------------------------------------------------------
// Inbound messages
// ---------------------------------------------------------------------------

model ContactMessage {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(191)
  phone     String?       @db.VarChar(40)
  topic     String        @db.VarChar(60)
  message   String        @db.Text
  locale    String        @default("en") @db.VarChar(5)
  status    ContactStatus @default(NEW)
  ipHash    String?       @db.VarChar(64)
  userAgent String?       @db.VarChar(255)
  createdAt DateTime      @default(now())
  readAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

/**
 * One row per click on a WhatsApp ordering action.
 *
 * IMPORTANT — what this is NOT: opening a wa.me link does not disclose the
 * visitor's own WhatsApp number to this website. Nothing here identifies a
 * person. `contactName` / `contactPhone` are populated only if a visitor
 * voluntarily typed them into an optional pre-contact form, and stay null
 * otherwise. These rows are interaction counts, not leads.
 */
model WhatsAppInteraction {
  id     Int            @id @default(autoincrement())
  source WhatsAppSource @default(GLOBAL)

  // Denormalised on purpose: the row stays readable after a product is
  // renamed, unpublished or archived. No FK, so analytics never block a delete.
  productId   Int?
  productSlug String? @db.VarChar(191)
  productName String? @db.VarChar(191)

  pagePath String @db.VarChar(300)
  locale   String @default("en") @db.VarChar(5)
  currency String @default("USD") @db.VarChar(3)

  // Random per-tab identifier held in sessionStorage. Not a cookie, not an id.
  sessionId String? @db.VarChar(64)

  contactName  String? @db.VarChar(120)
  contactPhone String? @db.VarChar(40)

  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([productId])
  @@map("whatsapp_interactions")
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  locale         String    @default("en") @db.VarChar(5)
  isActive       Boolean   @default(true)
  ipHash         String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([isActive])
  @@map("newsletter_subscribers")
}
