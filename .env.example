# ---------------------------------------------------------------------------
# MIAN DUBAI — Backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public base URL of THIS backend (no trailing slash).
PUBLIC_BASE_URL=http://localhost:4000

# Public base URL of the storefront (used for canonical URLs + sitemap).
SITE_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database — MySQL / MariaDB
# Local XAMPP default user is `root` with an empty password.
# Detect your real port instead of assuming 3306.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:@127.0.0.1:3306/miandubai"

# Used only by `npm run db:create` to create the database itself.
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_NAME=miandubai

# ---------------------------------------------------------------------------
# Security
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_NAME=mdb_admin_session
AUTH_COOKIE_DOMAIN=
# none | lax | strict  — use `none` only when admin + api are on different sites over HTTPS
AUTH_COOKIE_SAMESITE=lax
# Salt used to hash IP addresses before storing them in audit/contact records.
IP_HASH_SALT=change-me-too

# Comma separated. Never use "*" with credentialed requests.
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ---------------------------------------------------------------------------
# Persistent media storage
# MEDIA_STORAGE_DRIVER: filesystem | cloudinary
#
# filesystem (local development default)
# MEDIA_ROOT is required ONLY for the filesystem driver, and it **must** live
# outside this backend folder so that redeploying the backend can never delete
# uploaded product media.
#
# Local (XAMPP) suggestion:  C:/xampp/htdocs/miandubai-media
# Linux / cPanel suggestion: /home/<user>/public_html/media
# ---------------------------------------------------------------------------
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_ROOT=C:/xampp/htdocs/miandubai-media

# Filesystem driver only. Public URL that maps to MEDIA_ROOT. Leave EMPTY to let
# this backend serve the directory at `${PUBLIC_BASE_URL}/media`. Set it when the
# folder is served by Apache / Nginx / a CDN / a media subdomain,
# e.g. https://media.example.com
MEDIA_PUBLIC_URL=

MEDIA_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Production cloud storage example:
# MEDIA_STORAGE_DRIVER=cloudinary
#
# With MEDIA_STORAGE_DRIVER=cloudinary:
#   - All three CLOUDINARY_* values below are required; the backend refuses
#     to start if any of them is missing.
#   - MEDIA_ROOT is NOT required (it is only used by the filesystem driver).
#   - MEDIA_PUBLIC_URL is NOT required — secure https://res.cloudinary.com
#     delivery URLs are generated from each image's storage key.
#
# Credentials belong ONLY in the real `.env` file or in your hosting
# provider's environment variables. NEVER commit real values — keep these
# blank in this example file.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Hostinger SMTP / contact notifications
#
# Every contact-form submission is saved to the database first. When these
# variables are configured, the backend then emails a notification to
# CONTACT_NOTIFICATION_EMAIL with Reply-To set to the visitor, so replying
# from the Hostinger mailbox answers the customer directly. A mail failure is
# logged and never removes the saved message.
#
# All-or-nothing:
#   - Leave ALL of them unset or blank -> notifications are off and the
#     backend runs normally (fine for local development).
#   - Set ANY of them -> ALL are required; the backend refuses to start and
#     names each missing variable.
#   The pre-filled host/port/secure/from-name values below count as "set".
#   For local development without email, comment out or blank this block.
#
# Hostinger SMTP on port 465 uses SMTP_SECURE=true (implicit TLS).
# SMTP_USER is the full mailbox address. SMTP_FROM_EMAIL should normally be
# that same mailbox — Hostinger only accepts mail sent from the mailbox you
# log in with (or its aliases).
#
# Real values belong ONLY in the real `.env` file or in your hosting
# provider's environment variables (e.g. Vercel). NEVER commit an SMTP
# password — keep the account-specific values blank in this example file.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mian Dubai Website
CONTACT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
FEATURE_NEWSLETTER=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_CONTACT_MAX=5

LOG_LEVEL=info
