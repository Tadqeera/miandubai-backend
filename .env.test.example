# Environment for `npm test`. A SEPARATE database is used so the development
# data is never touched. Copy to `.env.test`.
NODE_ENV=test
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
SITE_BASE_URL=http://localhost:5173

DATABASE_URL="mysql://root:@127.0.0.1:3306/miandubai_test"
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_NAME=miandubai_test

AUTH_JWT_SECRET=test-secret-value-that-is-long-enough-for-validation
AUTH_SESSION_TTL_HOURS=1
AUTH_COOKIE_NAME=mdb_admin_session
AUTH_COOKIE_SAMESITE=lax
IP_HASH_SALT=test-salt

FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Deliberately OUTSIDE the backend folder, exactly as in production.
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_ROOT=../.miandubai-test-media
MEDIA_PUBLIC_URL=
MEDIA_MAX_UPLOAD_BYTES=10485760

FEATURE_NEWSLETTER=true
LOG_LEVEL=silent
